<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Asteria/Content/**/*.cs"
             Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/Server/**/*.cs"
             Link="Server/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/Client/**/*.cs"
             Link="Client/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/Serialization/**/*.cs"
             Link="Serialization/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/Core/**/*.cs"
             Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/Util/**/*.cs"
             Link="Util/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Asteria/World/**/*.cs"
             Link="World/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/worldgen/material-rule-catalog/*.json">
      <LogicalName>Asteria.Worldgen.MaterialRuleCatalog.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../data/worldgen/noise-settings/*.json">
      <LogicalName>Asteria.Worldgen.NoiseSettings.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
