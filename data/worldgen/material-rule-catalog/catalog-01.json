{
  "minecraft:bedrock_floor": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:vertical_gradient",
      "false_at_and_above": {
        "above_bottom": 5
      },
      "random_name": "minecraft:bedrock_floor",
      "true_at_and_below": {
        "above_bottom": 0
      }
    },
    "then_run": {
      "type": "minecraft:block",
      "result_state": "minecraft:bedrock"
    }
  },
  "minecraft:overworld": {
    "type": "minecraft:sequence",
    "sequence": [
      "minecraft:bedrock_floor",
      "minecraft:overworld/copper_ore_vein",
      "minecraft:overworld/iron_ore_vein",
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:above_preliminary_surface"
        },
        "then_run": "minecraft:overworld/surface"
      },
      "minecraft:overworld/underground"
    ]
  },
  "minecraft:overworld/biome_surface": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:frozen_peaks"
        },
        "then_run": "minecraft:overworld/biome_surface/frozen_peaks"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:snowy_slopes"
        },
        "then_run": "minecraft:overworld/biome_surface/snowy_slopes"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:jagged_peaks"
        },
        "then_run": "minecraft:overworld/biome_surface/jagged_peaks"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:grove"
        },
        "then_run": "minecraft:overworld/biome_surface/grove"
      },
      {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:stony_peaks"
            },
            "then_run": "minecraft:overworld/biome_surface/stony_peaks"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:stony_shore"
            },
            "then_run": "minecraft:overworld/biome_surface/stony_shore"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:windswept_hills"
            },
            "then_run": "minecraft:overworld/biome_surface/windswept_hills"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": [
                "minecraft:warm_ocean",
                "minecraft:beach",
                "minecraft:snowy_beach"
              ]
            },
            "then_run": "minecraft:overworld/sand_or_sandstone_if_ceiling"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:desert"
            },
            "then_run": "minecraft:overworld/sand_or_sandstone_if_ceiling"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:dripstone_caves"
            },
            "then_run": "minecraft:overworld/biome_surface/dripstone_caves"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:sulfur_caves"
            },
            "then_run": "minecraft:overworld/biome_surface/sulfur_caves"
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "minecraft:mangrove_swamp"
            },
            "then_run": "minecraft:overworld/biome_surface/mangrove_swamp"
          }
        ]
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:windswept_savanna"
        },
        "then_run": "minecraft:overworld/biome_surface/windswept_savanna"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:windswept_gravelly_hills"
        },
        "then_run": "minecraft:overworld/biome_surface/windswept_gravelly_hills"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": [
            "minecraft:old_growth_pine_taiga",
            "minecraft:old_growth_spruce_taiga"
          ]
        },
        "then_run": "minecraft:overworld/biome_surface/old_growth_pine_taiga"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:ice_spikes"
        },
        "then_run": "minecraft:overworld/biome_surface/ice_spikes"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:mushroom_fields"
        },
        "then_run": "minecraft:overworld/biome_surface/mushroom_fields"
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "minecraft:dappled_forest"
        },
        "then_run": "minecraft:overworld/biome_surface/dappled_forest"
      },
      "minecraft:overworld/biome_surface/default"
    ]
  },
  "minecraft:overworld/biome_surface/dappled_forest": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:noise_threshold",
      "max_threshold": 1.7976931348623157e+308,
      "min_threshold": 1.2000000476837158,
      "noise": "minecraft:small_patch"
    },
    "then_run": {
      "type": "minecraft:block",
      "result_state": "minecraft:coarse_dirt"
    }
  },
  "minecraft:overworld/biome_surface/default": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:grass_block"
        }
      },
      {
        "type": "minecraft:block",
        "result_state": "minecraft:dirt"
      }
    ]
  },
  "minecraft:overworld/biome_surface/dripstone_caves": {
    "type": "minecraft:block",
    "result_state": "minecraft:stone"
  },
  "minecraft:overworld/biome_surface/frozen_peaks": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:steep"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:packed_ice"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "max_threshold": 0.2,
          "min_threshold": 0,
          "noise": "minecraft:packed_ice"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:packed_ice"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "max_threshold": 0.025,
          "min_threshold": 0,
          "noise": "minecraft:ice"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:ice"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:snow_block"
        }
      }
    ]
  },
  "minecraft:overworld/biome_surface/grove": {
    "type": "minecraft:sequence",
    "sequence": [
      "minecraft:overworld/powder_snow_surface",
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:snow_block"
        }
      }
    ]
  },
  "minecraft:overworld/biome_surface/ice_spikes": {
    "type": "minecraft:condition",
    "if_true": "minecraft:not_underwater",
    "then_run": {
      "type": "minecraft:block",
      "result_state": "minecraft:snow_block"
    }
  },
  "minecraft:overworld/biome_surface/jagged_peaks": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:steep"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:stone"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:snow_block"
        }
      }
    ]
  },
  "minecraft:overworld/biome_surface/mangrove_swamp": {
    "type": "minecraft:block",
    "result_state": "minecraft:mud"
  },
  "minecraft:overworld/biome_surface/mushroom_fields": {
    "type": "minecraft:block",
    "result_state": "minecraft:mycelium"
  },
  "minecraft:overworld/biome_surface/old_growth_pine_taiga": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "max_threshold": 1.7976931348623157e+308,
          "min_threshold": 0.21212121212121213,
          "noise": "minecraft:surface"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:coarse_dirt"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "max_threshold": 1.7976931348623157e+308,
          "min_threshold": -0.11515151515151514,
          "noise": "minecraft:surface"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:podzol"
        }
      }
    ]
  }
}